---
import BaseLayout from "../layouts/BaseLayout.astro";
import { blogPosts } from "../data/blog";
---
<BaseLayout
  title="Blog | Verse Studio"
  description="Behind-the-scenes notes and production writeups from Verse Studio."
>
  <section class="section blog-index">
    <div class="blog-index__intro">
      <span class="badge">Blog</span>
      <h1>Process notes, breakdowns, and production writeups</h1>
      <p>
        Verse Studio uses this space for behind-the-scenes posts tied to finished releases,
        especially when a video or workflow needs a fuller explanation than the homepage can carry.
      </p>
    </div>

    <div class="blog-list">
      {blogPosts.map((post) => (
        <article class="card blog-card">
          <div class="blog-card__meta">
            <span class="badge">{post.badge}</span>
            <span class="blog-card__date">{post.publishedLabel}</span>
          </div>
          <h2>
            <a href={post.href}>{post.title}</a>
          </h2>
          <p>{post.summary}</p>
          {post.relatedVideoTitle && (
            <p class="blog-card__context">Related release: {post.relatedVideoTitle}</p>
          )}
          <p>
            <a class="btn" href={post.href}>Read Post</a>
          </p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .blog-index__intro { max-width: 760px; margin-bottom: clamp(32px, 5vw, 56px); }

  .blog-index__intro h1 {
    margin: 10px 0 16px;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
  }

  .blog-index__intro p { margin: 0; max-width: 58ch; color: var(--ink-2); font-size: 1.15rem; }

  .blog-list { display: grid; }

  .blog-card__meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;
  }

  .blog-card__date { color: var(--muted); font-size: 0.875rem; }

  .blog-card h2 { margin: 0 0 12px; font-size: clamp(1.5rem, 3vw, 2.1rem); }
  .blog-card h2 a { text-decoration: none; }
  .blog-card h2 a:hover { text-decoration: underline; }

  .blog-card p { margin: 0 0 12px; max-width: 62ch; color: var(--ink-2); }
  .blog-card__context { color: var(--muted); font-size: 0.95rem; }
  .blog-card .btn { margin-top: 10px; }
</style>
