---
// A poster that becomes the player on click: a YouTube embed (privacy-enhanced) or our own video file.
// Nothing from YouTube loads until someone presses play.
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface Props {
  title: string;
  youtube?: string;
  sources?: { src: string; type: string }[];
  poster?: ImageMetadata;
  posterUrl?: string;
  priority?: boolean;
  sizes?: string;
}
const { title, youtube, sources = [], poster, posterUrl, priority = false, sizes = "(max-width: 760px) 100vw, 60vw" } = Astro.props;
const fallbackPoster = youtube ? `https://i.ytimg.com/vi/${youtube}/maxresdefault.jpg` : undefined;
---
<div
  class="facade"
  data-youtube={youtube}
  data-sources={sources.length ? JSON.stringify(sources) : undefined}
  data-title={title}
>
  <button class="facade-button" type="button" aria-label={`Play ${title}`}>
    {poster ? (
      <Picture
        src={poster}
        alt=""
        formats={["avif", "webp"]}
        widths={[640, 960, 1280, 1600]}
        sizes={sizes}
        loading={priority ? "eager" : "lazy"}
        fetchpriority={priority ? "high" : "auto"}
        class="facade-image"
      />
    ) : (
      <img src={posterUrl ?? fallbackPoster} alt="" loading={priority ? "eager" : "lazy"} class="facade-image" />
    )}
    <span class="facade-play" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="22" height="22"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor" /></svg>
    </span>
  </button>
</div>

<script>
  function play(facade: HTMLElement) {
    const title = facade.dataset.title ?? "Video";
    const youtube = facade.dataset.youtube;
    let el: HTMLElement;
    if (youtube) {
      const iframe = document.createElement("iframe");
      iframe.src = `https://www.youtube-nocookie.com/embed/${youtube}?autoplay=1&rel=0&playsinline=1`;
      iframe.title = title;
      iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = "strict-origin-when-cross-origin";
      el = iframe;
    } else {
      const video = document.createElement("video");
      video.controls = true;
      video.autoplay = true;
      video.playsInline = true;
      video.setAttribute("aria-label", title);
      for (const s of JSON.parse(facade.dataset.sources ?? "[]") as { src: string; type: string }[]) {
        const source = document.createElement("source");
        source.src = s.src;
        source.type = s.type;
        video.append(source);
      }
      el = video;
    }
    el.className = "facade-player";
    facade.replaceChildren(el);
    facade.classList.add("is-playing");
    el.focus();
  }

  for (const facade of document.querySelectorAll<HTMLElement>(".facade")) {
    facade.querySelector("button")?.addEventListener("click", () => play(facade), { once: true });
  }
</script>

<style>
  .facade {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
    overflow: hidden;
  }

  .facade-button {
    all: unset;
    position: absolute;
    inset: 0;
    cursor: pointer;
  }

  .facade-button:focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; }

  .facade :global(.facade-image),
  .facade :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .facade :global(.facade-image) { object-fit: cover; }

  .facade-play {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 68px;
    height: 68px;
    margin: -34px 0 0 -34px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: var(--ink);
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.18);
    transition: transform 160ms, color 160ms;
  }

  .facade-play svg { margin-left: 3px; }

  .facade-button:hover .facade-play,
  .facade-button:focus-visible .facade-play {
    transform: scale(1.08);
    color: var(--teal-700);
  }

  .facade :global(.facade-player) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    background: #000;
  }
</style>
